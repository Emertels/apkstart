{
  "name": "apkstart-ptbr",
  "productName": "ApkStart PT-BR",
  "version": "0.4.4",
  "description": "Inicializador ultraleve de apps Android para Windows em Português do Brasil: instalação de APKs com dois cliques, atalhos na Área de Trabalho e janelas independentes",
  "main": "src/main.js",
  "author": "Emerson Teles",
  "license": "MIT",
  "private": true,
  "homepage": "https://github.com/Emertels/apkstart#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Emertels/apkstart.git"
  },
  "bugs": {
    "url": "https://github.com/Emertels/apkstart/issues"
  },
  "keywords": [
    "android",
    "emulator",
    "apk",
    "windows",
    "qemu",
    "electron",
    "wsa",
    "freeform"
  ],
  "engines": {
    "node": ">=20"
  },
  "os": [
    "win32"
  ],
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "test": "node test/run-tests.js && node test/engine-test.js && node test/auto-test.js",
    "pack": "node build/pack.js",
    "runtime": "node build/prepare-runtime.js",
    "build:exe": "node build/prepare-runtime.js && electron-builder --win nsis",
    "selftest": "node scripts/selftest.js",
    "assoc:on": "node scripts/assoc.js on",
    "assoc:off": "node scripts/assoc.js off",
    "test:boot": "node test/boot-test.js"
  },
  "devDependencies": {
    "electron": "^33.4.11",
    "electron-builder": "^26.18.0"
  },
  "dependencies": {
    "@napi-rs/lzma": "^1.5.3"
  }
}